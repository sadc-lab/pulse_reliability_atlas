#!/bin/sh
# PulseProbe pre-commit hook.
#
# Five steps, in order. This list was stale for months -- it announced two
# checks while the hook ran four -- so keep it in step with the code below.
#   0. Blocks sensitive internal review material from entering the history.
#   1. Regenerates experiments_log/INDEX.md from frontmatter and stages the
#      update into the current commit. Fast, idempotent, stdlib-only.
#   2. Runs the claims-ledger audit (all layers, one invocation) and blocks on
#      any FAIL, mirroring the GitHub Actions claims-audit job.
#   3. Runs the render check against the built PDFs, blocking on new problems
#      only. Local-only: CI has no PDFs. Skipped when the artefacts are absent.
#   4. Runs `ruff check` over the same scope as the GitHub Actions tests
#      workflow (src/ scripts/ tests/ engine/) and blocks the commit if any
#      violation remains. This catches CI-failing lint locally rather than
#      after push.
#
# Steps 2 and 4 have a CI twin, so a bypass gets caught on push. Step 3 does
# NOT: it is the only gate on the rendered artefacts, and nothing downstream
# will catch what it misses.
#
# To enable this hook in a fresh clone, run once:
#     git config core.hooksPath .githooks

set -e

# ---- 0. Block sensitive internal review material ---------------------------
#
# Supervisor / co-author annotated feedback documents and internal authorship /
# review to-do notes must NEVER enter the (soon-public) git history. .gitignore
# already excludes them from `git add .`, but this guard also catches an
# explicit `git add -f` and aborts the commit. `--diff-filter=d` excludes staged
# deletions, so REMOVING a sensitive file from tracking (the desired action when a
# previously-tracked note is reclassified as private) is allowed, while ADDING or
# modifying one is still blocked.
#
# TWO-TIER DESIGN, decided 2026-07-28 — do not "simplify" it into one tier.
# .gitignore stays strictly literal (one exact filename per line) so that nothing
# legitimate is ever ignored in silence: a file that .gitignore swallows is
# invisible and simply never gets published, which is a failure in the opposite
# direction and one nobody notices. This guard, by contrast, is allowed broad
# patterns, because its failure mode is loud: it stops the commit and prints why,
# forcing a human decision instead of making a file disappear from the index.
# So a new TODO_*.md is NOT auto-ignored, but it also cannot be committed by
# accident. If one is genuinely meant to be public, widen this pattern
# deliberately.
#
# Verified when the patterns were widened: `git ls-files` matched none of
# TODO_*, ROADMAP_*, NEXT_* at that time, so no existing tracked file is caught.
SENSITIVE=$(git diff --cached --name-only --diff-filter=d | grep -Exi '(Paper_retour_PJ\.pdf|paper_feedback_michaelSauthier\.docx|internal_morris_rebuttal\.md|(.*/)?TODO_.*\.md|(.*/)?ROADMAP_.*\.md|(.*/)?NEXT_SESSION.*\.md)' || true)
if [ -n "$SENSITIVE" ]; then
    echo ""
    echo "pre-commit: refusing to commit sensitive internal review material:"
    echo "$SENSITIVE" | sed 's/^/    /'
    echo ""
    echo "  These files (supervisor/reviewer feedback, internal authorship/review"
    echo "  notes) must not enter the public git history. Unstage them:"
    echo "    git restore --staged <file>"
    echo "  If a specific file is genuinely safe to publish, remove its pattern"
    echo "  from .githooks/pre-commit AND from .gitignore first."
    echo ""
    exit 1
fi

# ---- 1. Regenerate experiments_log/INDEX.md ---------------------------------

# Pick whichever Python is available (Git Bash on Windows usually has `python`;
# Linux / macOS often have only `python3`).
if command -v python >/dev/null 2>&1; then
    PY=python
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
else
    PY=""
    echo "pre-commit: python not found on PATH — skipping INDEX.md regeneration." >&2
fi

if [ -n "$PY" ]; then
    "$PY" scripts/regenerate_index.py
    # Stage the regenerated index if it changed (no-op otherwise).
    git add experiments_log/INDEX.md 2>/dev/null || true
fi

# ---- 2. Claims-ledger audit (mirrors GitHub Actions claims-audit job) -------
#
# Verifies every quantitative claim in preprint/manuscript.md (monograph) and
# preprint_npj/paper.tex + supplement.tex (npj submission) still matches the
# frozen data artifacts, and blocks the commit on any FAIL so numeric drift is
# caught locally rather than after push. A single run with both opt-in flags
# gates ALL THREE layers: its exit status is non-zero if the monograph ledger,
# the paper crosswalk, or the monograph anchor map has any FAIL. Prefer
# `uv run python` (matches CI); fall back to the hook's $PY; skip with a note
# if neither is available (CI still gates).
if command -v uv >/dev/null 2>&1; then
    AUDIT_CMD="uv run python"
elif [ -n "$PY" ]; then
    AUDIT_CMD="$PY"
else
    AUDIT_CMD=""
    echo "pre-commit: no python/uv for claims audit — skipping (CI will catch)." >&2
fi

if [ -n "$AUDIT_CMD" ]; then
    if ! $AUDIT_CMD scripts/audit_claims.py --check-paper-sync --check-monograph >/dev/null; then
        echo ""
        echo "pre-commit: claims-ledger audit FAILED — commit aborted."
        echo ""
        echo "  A quantitative claim in the monograph or paper.tex no longer"
        echo "  matches the frozen data artifacts, or the paper crosswalk or"
        echo "  the monograph anchor map drifted. Inspect the tables:"
        echo "    uv run python scripts/audit_claims.py --check-paper-sync --check-monograph"
        echo "  Fix the drifted number, or update preprint_npj/paper_to_monograph_map.md"
        echo "  or preprint/monograph_anchor_map.md, then re-stage and re-commit."
        echo "  This is the same gate as the GitHub Actions claims-audit job;"
        echo "  CI will fail on push if a FAIL remains."
        echo ""
        exit 1
    fi
fi

# ---- 2b. Portal-metadata sync (paper.tex -> submission_metadata.txt) --------
#
# preprint_npj/submission_metadata.txt is the text pasted into the npj portal.
# On 2026-08-23 an audit found its abstract had drifted from paper.tex in every
# sentence: 155 words against npj's 150-word cap, the H1 headline result missing
# entirely, the hyperoxia claim widened past what the paper says, and five of the
# paper's thirteen keywords gone. Nothing re-derived it, so the drift was
# invisible -- and TODO_publication_roadmap.md certified the file as synced while
# instructing the author to paste from it.
#
# The block is now generated, and this is the check that it still matches.
if [ -n "$AUDIT_CMD" ]; then
    if ! $AUDIT_CMD scripts/sync_submission_metadata.py --check >/dev/null 2>&1; then
        echo ""
        echo "pre-commit: portal metadata OUT OF SYNC with paper.tex - commit aborted."
        echo ""
        echo "  preprint_npj/submission_metadata.txt is what gets pasted into the"
        echo "  submission portal. Its title, running title, abstract and keywords"
        echo "  are generated from preprint_npj/paper.tex and must not be hand-edited."
        echo "  See the difference, then regenerate:"
        echo "    uv run python scripts/sync_submission_metadata.py --check"
        echo "    uv run python scripts/sync_submission_metadata.py"
        echo ""
        echo "  If it reports the abstract is over 150 words, fix paper.tex - that"
        echo "  is npj's cap, not ours."
        echo ""
        exit 1
    fi
fi

# ---- 3. Render check (no CI equivalent -- this is the only place it runs) ---
#
# audit_claims.py validates the SOURCES: it counts numeric literals in the .tex
# and .md files. It is blind to the renderer. On 2026-07-27 all its layers were
# green while paper Figure 1 was cut off mid-diagram and its caption had fallen
# off the page entirely -- the crosswalk faithfully counted numbers in a caption
# that never reached the PDF.
#
# scripts/check_render.py was written that day to close exactly that gap, and
# then wired NOWHERE for two weeks. This is that wiring.
#
# It cannot go in GitHub Actions: it reads the built PDFs, and preprint_npj/build
# is gitignored, so CI has nothing to look at. The pre-commit hook is the only
# place with real artefacts on disk. Consequences of that, both accepted:
#   * it is skipped, not failed, when the PDFs or uv are absent -- a contributor
#     without a LaTeX toolchain must still be able to commit;
#   * it can only see the PDFs as last built. A source edited after the last
#     build is checked against a stale artefact, so a staleness note is printed
#     below. It is a NOTE and not a failure on purpose: a newer source mtime is
#     not proof of a stale PDF (an edit that was applied and reverted moves the
#     mtime and changes nothing), and blocking on it would train people to
#     rebuild blindly to appease the hook.
#
# It blocks only on problems NOT in the script's documented baseline of four
# pre-existing typographic residues. See KNOWN_RESIDUES in check_render.py for
# why each is accepted and the rules for amending that set.
if command -v uv >/dev/null 2>&1 && [ -f preprint_npj/build/paper.pdf ]; then
    for src in preprint_npj/paper.tex preprint_npj/supplement.tex; do
        pdf="preprint_npj/build/$(basename "${src%.tex}").pdf"
        if [ -f "$pdf" ] && [ "$src" -nt "$pdf" ]; then
            echo "pre-commit: note -- $src is newer than $pdf; the render check" >&2
            echo "            below reads the PDF as last built, not your edit." >&2
        fi
    done
    if ! uv run --with pymupdf python scripts/check_render.py; then
        echo ""
        echo "pre-commit: render check FAILED — commit aborted."
        echo ""
        echo "  Something reached the built PDF that should not have, or"
        echo "  something declared in the source did not reach it. Only NEW"
        echo "  problems block; the four accepted residues never do. Inspect:"
        echo "    uv run --with pymupdf python scripts/check_render.py"
        echo "  If the finding is a genuine, measured, harmless residue, add it"
        echo "  to KNOWN_RESIDUES in scripts/check_render.py WITH its rationale."
        echo "  Never add one just to make this commit pass."
        echo ""
        exit 1
    fi
else
    echo "pre-commit: no uv, or preprint_npj/build/paper.pdf absent — skipping" >&2
    echo "            the render check (build the PDFs to enable it)." >&2
fi

# ---- 4. Ruff lint (mirrors GitHub Actions tests workflow) -------------------

# Prefer `uv run ruff` to match CI exactly; fall back to a plain `ruff`
# binary on PATH; if neither is available, skip with a clear note rather
# than blocking the commit (since the contributor may not have the project
# environment set up yet — CI will still catch it on push).
if command -v uv >/dev/null 2>&1; then
    RUFF_CMD="uv run ruff"
elif command -v ruff >/dev/null 2>&1; then
    RUFF_CMD="ruff"
else
    echo "pre-commit: ruff not found on PATH — skipping lint check." >&2
    echo "            install with:  uv add --dev ruff    (or)    pip install ruff" >&2
    exit 0
fi

if ! $RUFF_CMD check src/ scripts/ tests/ engine/; then
    echo ""
    echo "pre-commit: ruff lint failed — commit aborted."
    echo ""
    echo "  To auto-fix safe violations:"
    echo "    uv run ruff check --fix src/ scripts/ tests/ engine/"
    echo "  Then re-stage the affected files and re-commit:"
    echo "    git add <files>"
    echo "    git commit"
    echo ""
    echo "  This is the same check that runs in GitHub Actions; CI will fail"
    echo "  on push if these violations remain."
    exit 1
fi
