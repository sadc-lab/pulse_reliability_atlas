#!/bin/sh
# PulseProbe pre-commit hook.
#
# Two checks, in order:
#   1. Regenerates experiments_log/INDEX.md from frontmatter and stages the
#      update into the current commit. Fast, idempotent, stdlib-only.
#   2. Runs `ruff check` over the same scope as the GitHub Actions tests
#      workflow (src/ scripts/ tests/ engine/) and blocks the commit if any
#      violation remains. This catches CI-failing lint locally rather than
#      after push.
#
# To enable this hook in a fresh clone, run once:
#     git config core.hooksPath .githooks

set -e

# ---- 0. Block sensitive internal review material ---------------------------
#
# Supervisor / co-author annotated feedback documents and internal authorship /
# review to-do notes must NEVER enter the (soon-public) git history. .gitignore
# already excludes them from `git add .`, but this guard also catches an
# explicit `git add -f` and aborts the commit. `--diff-filter=d` excludes staged
# deletions, so REMOVING a sensitive file from tracking (the desired action when a
# previously-tracked note is reclassified as private) is allowed, while ADDING or
# modifying one is still blocked.
SENSITIVE=$(git diff --cached --name-only --diff-filter=d | grep -Exi '(Paper_retour_PJ\.pdf|paper_feedback_michaelSauthier\.docx|TODO_PJ_feedback\.md|TODO_yassir_track\.md|TODO_publication_roadmap\.md|internal_morris_rebuttal\.md)' || true)
if [ -n "$SENSITIVE" ]; then
    echo ""
    echo "pre-commit: refusing to commit sensitive internal review material:"
    echo "$SENSITIVE" | sed 's/^/    /'
    echo ""
    echo "  These files (supervisor/reviewer feedback, internal authorship/review"
    echo "  notes) must not enter the public git history. Unstage them:"
    echo "    git restore --staged <file>"
    echo "  If a specific file is genuinely safe to publish, remove its pattern"
    echo "  from .githooks/pre-commit AND from .gitignore first."
    echo ""
    exit 1
fi

# ---- 1. Regenerate experiments_log/INDEX.md ---------------------------------

# Pick whichever Python is available (Git Bash on Windows usually has `python`;
# Linux / macOS often have only `python3`).
if command -v python >/dev/null 2>&1; then
    PY=python
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
else
    PY=""
    echo "pre-commit: python not found on PATH — skipping INDEX.md regeneration." >&2
fi

if [ -n "$PY" ]; then
    "$PY" scripts/regenerate_index.py
    # Stage the regenerated index if it changed (no-op otherwise).
    git add experiments_log/INDEX.md 2>/dev/null || true
fi

# ---- 2. Claims-ledger audit (mirrors GitHub Actions claims-audit job) -------
#
# Verifies every quantitative claim in preprint/manuscript.md (monograph) and
# preprint_npj/paper.tex + supplement.tex (npj submission) still matches the
# frozen data artifacts, and blocks the commit on any FAIL so numeric drift is
# caught locally rather than after push. A single --check-paper-sync run gates
# BOTH layers: its exit status is non-zero if the monograph ledger OR the
# paper crosswalk has any FAIL. Prefer `uv run python` (matches CI); fall back
# to the hook's $PY; skip with a note if neither is available (CI still gates).
if command -v uv >/dev/null 2>&1; then
    AUDIT_CMD="uv run python"
elif [ -n "$PY" ]; then
    AUDIT_CMD="$PY"
else
    AUDIT_CMD=""
    echo "pre-commit: no python/uv for claims audit — skipping (CI will catch)." >&2
fi

if [ -n "$AUDIT_CMD" ]; then
    if ! $AUDIT_CMD scripts/audit_claims.py --check-paper-sync >/dev/null; then
        echo ""
        echo "pre-commit: claims-ledger audit FAILED — commit aborted."
        echo ""
        echo "  A quantitative claim in the monograph or paper.tex no longer"
        echo "  matches the frozen data artifacts (or the crosswalk drifted)."
        echo "  Inspect the discrepancy table:"
        echo "    uv run python scripts/audit_claims.py --check-paper-sync"
        echo "  Fix the drifted number (or update preprint_npj/paper_to_monograph_map.md),"
        echo "  re-stage, and re-commit. This is the same gate as the GitHub Actions"
        echo "  claims-audit job; CI will fail on push if a FAIL remains."
        echo ""
        exit 1
    fi
fi

# ---- 3. Ruff lint (mirrors GitHub Actions tests workflow) -------------------

# Prefer `uv run ruff` to match CI exactly; fall back to a plain `ruff`
# binary on PATH; if neither is available, skip with a clear note rather
# than blocking the commit (since the contributor may not have the project
# environment set up yet — CI will still catch it on push).
if command -v uv >/dev/null 2>&1; then
    RUFF_CMD="uv run ruff"
elif command -v ruff >/dev/null 2>&1; then
    RUFF_CMD="ruff"
else
    echo "pre-commit: ruff not found on PATH — skipping lint check." >&2
    echo "            install with:  uv add --dev ruff    (or)    pip install ruff" >&2
    exit 0
fi

if ! $RUFF_CMD check src/ scripts/ tests/ engine/; then
    echo ""
    echo "pre-commit: ruff lint failed — commit aborted."
    echo ""
    echo "  To auto-fix safe violations:"
    echo "    uv run ruff check --fix src/ scripts/ tests/ engine/"
    echo "  Then re-stage the affected files and re-commit:"
    echo "    git add <files>"
    echo "    git commit"
    echo ""
    echo "  This is the same check that runs in GitHub Actions; CI will fail"
    echo "  on push if these violations remain."
    exit 1
fi
