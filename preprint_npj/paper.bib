@book{west2020respiratory,
  author    = {West, J B and Luks, A M},
  title     = {West's Respiratory Physiology: The Essentials},
  edition   = {11th},
  publisher = {Wolters Kluwer Health / Lippincott},
  address   = {Philadelphia, PA},
  year      = {2020},
  isbn      = {978-1-9751-3918-6},
  note      = {Reference respiratory-physiology textbook. Publication date September 29, 2020 (Wolters Kluwer publisher record, verified 2026-05-21). ISBN-13 9781975139186 (print) verified against publisher catalog. Used in §2.6: Chapter 2 (Ventilation) documents anatomical dead space (typically 150 mL in adult-reference body habitus), justifying the Vt = 50 mL lower bound (alveolar ventilation impossible below dead space); Chapter 4 (Blood Gas Transport) anchors the PaCO2 acid-base survival range; Chapter 5 (Gas Exchange) documents the alveolar-gas equation that anchors the PaO2 upper bound and the supplementary HARD_BOUNDS_PHYSIOLOGICAL classifier (§3.8); Chapter 7 (Ventilation-Perfusion Relationships) anchors the shunt physiology recovered by the S021 hyperoxia convergence experiment.}
}

