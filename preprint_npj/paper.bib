@article{severinghaus1979,
  author    = {Severinghaus, J W},
  title     = {Simple, accurate equations for human blood {O2} dissociation computations},
  journal   = {Journal of Applied Physiology: Respiratory, Environmental and Exercise Physiology},
  volume    = {46},
  number    = {3},
  pages     = {599--602},
  year      = {1979},
  doi       = {10.1152/jappl.1979.46.3.599},
  note      = {PMID: 35496 (verified via PubMed esummary, 2026-05-21). Reference equation for the oxyhemoglobin dissociation curve. Anchors the SpO2-PaO2 mapping used in this manuscript: SpO2 = 50 percent corresponds to the canonical P50 at PaO2 $\approx$ 27 mmHg, below the threshold for cellular oxygen extraction. Used in §2.6 to defend the (PaO2 lower, SpO2 lower) implausibility hard bounds.}
}

@article{singer2016,
  author    = {Singer, M and Deutschman, C S and Seymour, C W and Shankar-Hari, M and Annane, D and Bauer, M and Bellomo, R and Bernard, G R and Chiche, J D and Coopersmith, C M and Hotchkiss, R S and Levy, M M and Marshall, J C and Martin, G S and Opal, S M and Rubenfeld, G D and van der Poll, T and Vincent, J L and Angus, D C},
  title     = {The Third International Consensus Definitions for Sepsis and Septic Shock ({Sepsis-3})},
  journal   = {JAMA},
  volume    = {315},
  number    = {8},
  pages     = {801--810},
  year      = {2016},
  doi       = {10.1001/jama.2016.0287},
  note      = {PMID: 26903338 (verified via PubMed esummary, 2026-05-21). Sepsis-3 defines septic shock as requiring vasopressor support to maintain MAP $\geq$ 65 mmHg in the presence of persistent hypotension; MAP $<$ 30 mmHg is well below autoregulated organ-perfusion threshold. Used in §2.6 to defend the MAP lower implausibility bound.}
}

