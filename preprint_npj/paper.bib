  author    = {Webb, J B and Bray, A and Scheirich, H and VanPelt, J and Gerard, J and Frembgen, S and Clipp, R B},
  title     = {Implementation of a Dynamic and Extensible Mechanical Ventilator Model for Real-Time Physiological Simulation},
  howpublished = {Proceedings of the 2022 Annual Modeling and Simulation Conference (ANNSIM)},
  year      = {2022},
  url       = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC10224749/},
  note      = {PubMed Central: PMC10224749. Entry corrected 2026-05-12 in pre-submission audit; previously listed under an invented title "PulseExt..." with an incorrect author list (the missing-Asare confusion was a copy-from-webb2020 error). Paper reports qualitative waveform agreement between Pulse and the ASL 5000 lung simulator across nine validation cases (healthy / restrictive / obstructive lung profiles x PC-AC / VC-AC / CPAP modes); does NOT report quantitative tidal-volume error percentages. The 0.07-2.25 percent VC-AC and 11.3-25.3 percent PC-AC tidal-volume error numbers cited elsewhere in this manuscript come from the Pulse documentation tables (see @pulsevent), not from this paper.}
}

