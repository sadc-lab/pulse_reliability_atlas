@article{severinghaus1979,
  author    = {Severinghaus, J W},
  title     = {Simple, accurate equations for human blood {O2} dissociation computations},
  journal   = {Journal of Applied Physiology: Respiratory, Environmental and Exercise Physiology},
  volume    = {46},
  number    = {3},
  pages     = {599--602},
  year      = {1979},
  doi       = {10.1152/jappl.1979.46.3.599},
  pmid      = {35496},
  internal_note = {Canonical reference equation for the oxyhemoglobin dissociation curve. Read at source 2026-07-28: the PubMed abstract (PMID 35496) carries the equations themselves, verbatim Eq. (1): "S = (((Po2(3) + 150 Po2)(-1) x 23,400) + 1)(-1)". Evaluating that equation gives P50 = 26.86 mmHg, S(27 mmHg) = 0.5035 and S(20 mmHg) = 0.3198. Consequences, recorded so neither is re-corrected by guesswork. (a) The "approximately 27 mmHg" used by the manuscripts is right on both sources -- the equation gives 26.86, and West's Respiratory Physiology 11th ed., p. 200 states "The normal value for human blood is about 27 mm Hg", anchor point "P50: 27, SO2 50 percent". (b) The 26.6 mmHg this field carried before 2026-07-27 was NOT invented: 26.6 appears in the paper's Eq. (4), the Bohr-coefficient normalisation, not as the P50 of Eq. (1). Do not reinstate it as a P50. (c) OPEN [2026-07-28]: supplement.tex L221 and manuscript.md L1095 state that PaO2 = 20 mmHg corresponds to SpO2 approximately 0.30 on this curve; the equation gives 0.3198. Flagged for author decision, nothing changed in the manuscripts.}
}

