@article{katsoulakis2024digitaltwins,
  author    = {Katsoulakis, E and Wang, Q and Wu, H and Shahriyari, L and Fletcher, R and Liu, J and Achenie, L and Liu, H and Jackson, P and Xiao, Y and Syeda-Mahmood, T and Tuli, R and Deng, J},
  title     = {Digital twins for health: a scoping review},
  journal   = {{npj} Digital Medicine},
  volume    = {7},
  number    = {1},
  pages     = {77},
  year      = {2024},
  doi       = {10.1038/s41746-024-01073-0},
  pmid      = {38519626},
  internal_note = {npj Digital Medicine scoping review of digital twins for health; cited as field framing for virtual/synthetic-patient and in-silico physiological modelling. VERIFICATION DEPTH: the full text (Europe PMC PMC10960047) was already read and recorded MATCH for the paper.tex:130 use in audit/reference_audit.md L782, audited 2026-07-24/26/27; that depth was simply never mirrored into this note, which is why it was re-read on 2026-08-14. The current use is confirmed verbatim from the abstract, "The use of digital twins (DTs) has proliferated across various fields and industries, with a recent surge in the healthcare sector", and is backed in the body by a measured trend, "the ratio of the number of publications on digital twins for healthcare to the number of publications on digital twins in general has been steadily increasing over the years". SCOPE BOUNDARY established 2026-08-14 for a prospective Introduction use. The review SUPPORTS, verbatim: "Creating and maintaining DTs for health that evolve over time to represent changes in a person's health or a biological system requires access to longitudinal data. This data is often scarce and may have gaps." It DOES NOT SUPPORT the adjacent, stronger claim that specific clinically relevant regimes are sparsely observed or hard to sample systematically: regime coverage is not the same quantity as data volume or continuity, and the review never measures it. Use only for longitudinal-data scarcity and gaps. CAUTION: that scarcity sentence carries no reference of its own and sits in a passage enumerating obstacles to BUILDING digital twins (data fragmented across institutions, noisy, biased, labour-intensive to label), not a motivation for simulation. Cite it for the factual premise only, and never imply the review concludes that simulation answers it.}
}

@article{vanbreugel2024synthetic,
  author    = {{van Breugel}, B and Liu, T and Oglic, D and {van der Schaar}, M},
  title     = {Synthetic data in biomedicine via generative artificial intelligence},
  journal   = {Nature Reviews Bioengineering},
  volume    = {2},
  number    = {12},
  pages     = {991--1004},
  year      = {2024},
  doi       = {10.1038/s44222-024-00245-7},
  internal_note = {Review article. Metadata verified 2026-09-15 at Crossref and on the nature.com article page (volume 2, issue 12, pages 991-1004, online 2024-10-08); no PubMed record found by DOI search (a positive control on katsoulakis2024digitaltwins returned its PMID), so no pmid field. VERIFICATION DEPTH: FULL TEXT READ 2026-09-15 from the PDF supplied by the author (14 pages), after the publisher page, OpenAlex and Semantic Scholar had shown it closed. Two uses in the Introduction. (1) Abstract, verbatim: "generative-model-based data augmentation can address data scarcity; synthetic data can improve data fairness and reduce bias by accounting for underrepresented groups; and unseen scenarios may be simulated with synthetic data." Box 2 extends the unseen-scenario point to mechanistic simulators ("These scenarios might not have been observed in the training set"). (2) The review CITES PULSE: "Generative models can be classified into mechanistic generators and data-driven generative models. Mechanistic generators17-20 (Box 2) are constructed from first principles"; its reference 19 is Bray et al. 2019 (bray2019) and reference 20 is Webb et al. 2020 (webb2020); Box 2 cites reference 19 again for "interacting physiological models can be applied to study whole-body responses to diseases and injuries". CAUTION: the same passage calls mechanistic generators "inherently robust"; the sense is stability against the training randomness of data-driven models, not absence of solver failure, so never cite this review for the reliability of a mechanistic simulator, and never present the atlas as contradicting it. The review's substance is deep generative models; mechanistic simulators occupy Box 2.}
}

